{
  "name": "ayden-market-backend",
  "version": "1.0.0",
  "main": "dist/server-mock.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:mock": "ts-node-dev --respawn --transpile-only src/server-mock.ts",
    "build": "npx tsc --skipLibCheck src/server-mock.ts src/cryptobot.ts --outDir dist --esModuleInterop --module commonjs --target es2020 --resolveJsonModule",
    "start": "node dist/server-mock.js"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "nodemailer": "^7.0.12",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
