PORT=3001
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=techshop
FRONTEND_URL=https://fast-pay-ai.vercel.app

# CryptoBot API Token - IMPORTANT: No quotes, no spaces!
# Get your token from @CryptoBot in Telegram
# Format: 12345:ABCDEF...
CRYPTOBOT_TOKEN=your_cryptobot_token_here

# CactusPay API Token
# Get your token from CactusPay dashboard: https://lk.cactuspay.pro
# After registration, find it in your shop settings
CACTUSPAY_TOKEN=your_cactuspay_token_here

# JWT Secret for authentication (auto-generated if not set)
# Use a strong random string in production
JWT_SECRET=your_jwt_secret_here

# Telegram Bot Token for WebApp validation
# Get from @BotFather in Telegram
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated Telegram user IDs)
ADMIN_IDS=1301598469

# Environment (development/production)
NODE_ENV=development
